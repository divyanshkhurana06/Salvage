# Copy this file to .env and fill in the values. Never commit .env.

# Ethereum archive RPC used to create the local fork (Alchemy, Infura, or a public endpoint).
# Public endpoints that serve archive reads worked for testing: https://eth.drpc.org and https://eth-mainnet.public.blastapi.io
ETH_RPC_URL=https://eth.drpc.org

# Where the local Anvil fork listens. scripts/start_fork.sh starts it here.
FORK_RPC_URL=http://127.0.0.1:8545

# Pin the fork to a block so test wallets and ground truth stay stable between runs.
# Leave empty to fork the latest block.
FORK_BLOCK=

# Base, the second chain (optional). Same shape: an archive RPC upstream, a local fork, a pinned block.
# Public endpoints that served archive reads for a fork in testing: https://base-mainnet.public.blastapi.io,
# https://base.gateway.tenderly.co, https://base-pokt.nodies.app. dRPC and the official RPC rate limit a fork.
# Leave BASE_RPC_URL empty to run on Ethereum only.
BASE_RPC_URL=https://base-mainnet.public.blastapi.io
BASE_FORK_RPC_URL=http://127.0.0.1:8546
BASE_FORK_BLOCK=

# Anthropic API key and the model id the agent should use.
ANTHROPIC_API_KEY=
MODEL_ID=

# PRISM (prism.blockconvey.com). Project id is in Settings then Project. Create an ingest key on the API keys page.
PRISMTRACE_HOST=https://prism-api-prod.up.railway.app
PRISMTRACE_PROJECT_ID=7ea1de2d-044a-4a19-afc5-3c2863c2e8e2
PRISMTRACE_API_KEY=

# Which agent version to run by default: v1 (naive) or v2 (verified)
AGENT_VERSION=v2

# Public deployment (optional): when set, the UI asks for this code once before it can talk to the agents,
# so a shared link cannot spend the model key. Leave empty when running locally.
ACCESS_CODE=

# ElevenLabs voice agent (optional) and the ngrok tunnel that lets it reach this laptop
ELEVENLABS_API_KEY=
NGROK_AUTHTOKEN=
ELEVENLABS_AGENT_ID=
PUBLIC_URL=
ELEVENLABS_WEBHOOK_ID=
ELEVENLABS_WEBHOOK_SECRET=
